# rmu-api-attack-tables: container on the rmu-platform Docker network (`make docker-run`). Copy to .env.docker.
# Requires the infrastructure started from rmu-platform (network rmu-network), so the hosts are the container names.
# In the full Compose stack (profile apis) rmu-platform/compose/apis.yaml injects these values and this file is not
# used.

# --- Server ---------------------------------------------------------------------------------------
PORT=3005
LOG_LEVEL=debug

# --- Tables ---------------------------------------------------------------------------------------
# Empty: the tables bundled in the image only (no spell casting tables).
RMU_ATTACK_TABLES_DIR=

# --- Keycloak -------------------------------------------------------------------------------------
RMU_IAM_JWK_URI=http://rmu-keycloak:8080/sso/realms/rmu/protocol/openid-connect/certs
RMU_IAM_ISSUER_URI=http://localhost/sso/realms/rmu
RMU_IAM_AUDIENCE=rmu-api

# --- HTTP (optional) --------------------------------------------------------------------------------
# No origins: CORS stays off. RMU_THROTTLE_LIMIT=0 turns the request limit off.
RMU_CORS_ORIGINS=
RMU_THROTTLE_LIMIT=1000
RMU_THROTTLE_TTL_MS=60000
RMU_TRUST_PROXY=loopback, linklocal, uniquelocal
