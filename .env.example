# rmu-api-attack-tables: local development outside Docker. Copy to .env.
# The API does not load .env by itself: export the values (e.g. `set -a; . ./.env; set +a`).

# --- Server ------------------------------------------------------------------------------------
PORT=3005

# --- Tables ------------------------------------------------------------------------------------
# Folder with the attack, critical and fumble tables. Empty or unset: the bundled tables/ folder.
# Accepts tables/-style subfolders (attack, critical, fumble) or the workspace data layout
# (attack-tables, critical-tables, fumble-tables); a file missing there falls back to tables/.
# Example, from a workspace checkout: RMU_ATTACK_TABLES_DIR=../data/core-law
RMU_ATTACK_TABLES_DIR=
