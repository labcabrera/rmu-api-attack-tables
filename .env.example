# rmu-api-attack-tables: local development outside Docker (`pnpm start:dev`). Copy to .env.
# Requires Keycloak, started from rmu-platform (`make up-infra`): http://localhost:8090/sso from the host. The API has
# no database and no Kafka: the tables are files.

# --- Server ---------------------------------------------------------------------------------------
PORT=3005
LOG_LEVEL=debug

# --- Tables ---------------------------------------------------------------------------------------
# Folder with the tables (two layouts, see the README). Empty: the bundled tables/ folder only. The spell casting
# tables are not bundled: point it to the workspace data/core-law to serve them.
RMU_ATTACK_TABLES_DIR=../data/core-law

# --- Keycloak -------------------------------------------------------------------------------------
# RMU_IAM_URI and RMU_IAM_REALM are optional: they only build the OAuth URLs of the Swagger UI.
RMU_IAM_URI=http://localhost/sso
RMU_IAM_REALM=rmu
RMU_IAM_JWK_URI=http://localhost:8090/sso/realms/rmu/protocol/openid-connect/certs
RMU_IAM_ISSUER_URI=http://localhost/sso/realms/rmu
RMU_IAM_AUDIENCE=rmu-api

# --- HTTP (optional) --------------------------------------------------------------------------------
# No origins: CORS stays off. RMU_THROTTLE_LIMIT=0 turns the request limit off.
RMU_CORS_ORIGINS=
RMU_THROTTLE_LIMIT=1000
RMU_THROTTLE_TTL_MS=60000
RMU_TRUST_PROXY=loopback, linklocal, uniquelocal
